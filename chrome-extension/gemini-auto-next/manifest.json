{
  "manifest_version": 3,
  "name": "Gemini 자동 다음 단계",
  "version": "1.0.0",
  "description": "Gemini(Gems 포함, gemini.google.com)에서 응답이 끝날 때마다 '다음 단계 진행해'를 지정한 횟수만큼 자동으로 전송합니다.",
  "permissions": ["activeTab", "tabs"],
  "host_permissions": ["https://gemini.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini 자동 다음 단계"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
