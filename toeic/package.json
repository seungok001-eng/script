{
  "name": "toeicfit",
  "version": "1.0.0",
  "private": true,
  "description": "토익핏 — 목표 점수 맞춤 토익 단어·실전·모의고사 (Android/iOS/PC)",
  "scripts": {
    "build:data": "node scripts/build_data.mjs",
    "validate": "python3 scripts/validate_day.py",
    "serve": "cd app && python3 -m http.server 8080",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "assets": "npx capacitor-assets generate --ios --android --iconBackgroundColor '#2b59f0' --iconBackgroundColorDark '#1a3bb8' --splashBackgroundColor '#f4f6fb' --splashBackgroundColorDark '#0d1117'"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capgo/native-purchases": "^8.8.1"
  }
}
